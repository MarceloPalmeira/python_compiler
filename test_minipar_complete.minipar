# MiniPar Example - More complete test
func fatorial(n: number) -> number {
    if (n == 0 || n == 1) {
        return 1
    } else {
        return n * fatorial(n - 1)
    }
}

var result: number = fatorial(5)
print("Fatorial de 5:", result)

# Teste com operadores lógicos
